# =============================================================================
# Domain Arbitrage Intelligence Engine - configuration
# Copy to .env and edit. Every value here has a safe default; the defaults
# leave external data sources OFF, which means those fields report MISSING
# rather than being guessed.
# =============================================================================

# --- storage -----------------------------------------------------------------
# SQLite by default. To move to PostgreSQL, change this line only:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/domain_arbitrage
DATABASE_URL=sqlite:///./data/domain_arbitrage.db
SQL_ECHO=false

# --- scoring -----------------------------------------------------------------
# The versioned weights file. Its stamp is recorded on every prediction.
SCORING_CONFIG_PATH=./config/scoring_v0.yaml

# --- keyword / commercial-intent data ----------------------------------------
# null = no source; search volume, CPC and competition are reported MISSING.
# csv  = read from a keyword export you supply.
KEYWORD_PROVIDER=null
# KEYWORD_CSV_PATH=./data/keywords.csv

# Credentials for live keyword providers. None is implemented yet; these are
# the hooks a new KeywordProvider would read. See app/providers/keyword.py.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEMRUSH_API_KEY=
AHREFS_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- buyer discovery ---------------------------------------------------------
# The primary signal. Point this at a company dataset with columns:
#   company_name,company_domain,industry,keywords,employee_count,revenue_usd,
#   funding_usd,funding_currency,last_funding_date,evidence_url,country
# Without it, buyer depth is UNKNOWN for every domain and no BUY is possible.
BUYER_PROVIDER=csv
# BUYER_COMPANY_CSV_PATH=./data/companies.csv

# --- comparable sales --------------------------------------------------------
# Load with: python scripts/load_comparables.py <file.csv> --source namebio
# COMPS_CSV_PATH=./data/comparable_sales.csv

# --- LLM ---------------------------------------------------------------------
# Used ONLY for semantic classification and buyer/domain reasoning. Never for
# arithmetic or scoring rules. Responses are cached in SQLite.
LLM_PROVIDER=null
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_CALLS_PER_RUN=200
LLM_CACHE_ENABLED=true

# --- integrity ---------------------------------------------------------------
# Enables the SYNTHETIC example company file so the pipeline can be demonstrated
# with no data sources. Everything it produces is tagged FIXTURE and is not
# evidence. Leave false for any real work.
ALLOW_FIXTURE_DATA=false

# --- economics ---------------------------------------------------------------
ANNUAL_RENEWAL_COST_USD=11.0
TRANSACTION_COST_RATE=0.15
TRANSFER_COST_USD=0.0
