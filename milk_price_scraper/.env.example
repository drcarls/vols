# Bright Data credentials -- copy this file to `.env` and fill in.
# Never commit the real .env (it is gitignored).

# Required for BOTH strategies. Create at: Bright Data dashboard -> Account settings -> API tokens
BRIGHTDATA_API_TOKEN=

# Required for the "unlocker" strategy only.
# The name of your Web Unlocker zone (Bright Data dashboard -> Proxies & Scraping -> your Web Unlocker zone).
BRIGHTDATA_UNLOCKER_ZONE=

# Required for the "dataset" strategy only (RECOMMENDED for Instacart).
# The dataset/collector id for Bright Data's Instacart product scraper.
# Find it on the dataset's page in the Bright Data dashboard (looks like gd_xxxxxxxxxxxxx).
BRIGHTDATA_INSTACART_DATASET_ID=
